# Origin of the orchestrator API during `next dev`. In production the static
# export is served by FastAPI itself, so this is only used in local dev.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Prefix under which FastAPI mounts the exported bundle. Should match the
# `StaticFiles` mount point in `core/orchestrator.py` (default: /static).
NEXT_PUBLIC_ASSET_PREFIX=/static
